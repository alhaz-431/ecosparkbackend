generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(MEMBER)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  ideas     Idea[]
  payments  Payment[]
  votes     Vote[]
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  ideas Idea[]
}

model Idea {
  id               String     @id @default(uuid())
  title            String
  problemStatement String
  solution         String
  description      String
  images           String[]
  status           IdeaStatus @default(DRAFT)
  type             IdeaType   @default(FREE)
  price            Float?
  feedbackNote     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  authorId         String
  categoryId       String
  author           User       @relation(fields: [authorId], references: [id])
  category         Category   @relation(fields: [categoryId], references: [id])
  payments         Payment[]
  votes            Vote[]
}

model Vote {
  id     String @id @default(uuid())
  value  Int
  userId String
  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, ideaId])
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  ideaId    String
  amount    Float
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())
  idea      Idea     @relation(fields: [ideaId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  MEMBER
  ADMIN
}

enum IdeaStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum IdeaType {
  FREE
  PAID
}
